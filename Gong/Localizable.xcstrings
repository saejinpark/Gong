    "0.5 단위로 조절돼요. 잔업·야간은 현장에서 정한 공수로 넣어 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adjusts in steps of 0.5. Enter overtime or night work as the gongsu your site sets."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "0.5 단위로 조절돼요. 잔업·야간은 현장에서 정한 공수로 넣어 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Шаг 0,5. Сверхурочные и ночные смены вводите так, как их считает объект."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "0,5 qadam bilan oʻzgaradi. Qoʻshimcha va tungi ishni obyekt belgilagan gongsu boʻyicha kiriting."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tăng giảm theo 0.5. Tăng ca, ca đêm thì nhập theo số công do công trường quy định."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按0.5调整。加班、夜班请按工地规定的工数填写。"
          }
        }
      }
    },
