            "value": "新工地默认值"
          }
        }
      }
    },
    "새 현장을 만들 때 미리 채워지는 값이에요. 현장마다 따로 바꿀 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These fill in automatically when you add a site. You can change them for each site."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "새 현장을 만들 때 미리 채워지는 값이에요. 현장마다 따로 바꿀 수 있어요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подставляются при создании объекта. Для каждого объекта можно изменить."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Yangi obyekt qoʻshilganda avtomatik toʻldiriladi. Har bir obyekt uchun oʻzgartirish mumkin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự điền khi thêm công trường mới. Có thể đổi riêng cho từng công trường."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新建工地时自动填入，每个工地可单独修改。"
          }
        }
      }
    },
