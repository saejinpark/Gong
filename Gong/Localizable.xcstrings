          }
        }
      }
    },
    "끝난 현장은 꺼 두면 공수 입력 목록에서 사라져요. 기록은 그대로 남아요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn off a finished site to hide it from the entry list. Its records stay."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끝난 현장은 꺼 두면 공수 입력 목록에서 사라져요. 기록은 그대로 남아요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключите завершённый объект, чтобы скрыть его из списка. Записи сохранятся."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugagan obyektni oʻchirsangiz, roʻyxatdan yashiriladi. Yozuvlar saqlanib qoladi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt công trường đã xong để ẩn khỏi danh sách ghi công. Bản ghi vẫn giữ nguyên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已结束的工地关掉后不会出现在记工列表里，记录会保留。"
          }
        }
      }
    },
