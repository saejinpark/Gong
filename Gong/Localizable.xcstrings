    "지금 저장된 기록이 모두 지워지고 백업 내용(현장 %lld개, 기록 %lld건, %@ 저장)으로 바뀌어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All current data will be replaced with the backup (%1$lld sites, %2$lld records, saved %3$@)."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 저장된 기록이 모두 지워지고 백업 내용(현장 %lld개, 기록 %lld건, %@ 저장)으로 바뀌어요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Все текущие данные будут заменены резервной копией (объектов: %1$lld, записей: %2$lld, сохранена %3$@)."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Hozirgi barcha maʻlumotlar zaxira bilan almashtiriladi (%1$lld obyekt, %2$lld yozuv, saqlangan: %3$@)."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Toàn bộ dữ liệu hiện tại sẽ bị xóa và thay bằng bản sao lưu (%1$lld công trường, %2$lld bản ghi, lưu lúc %3$@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前所有记录将被删除，并替换为备份内容（工地%1$lld个、记录%2$lld条，保存于%3$@）。"
          }
        }
      }
    },
    "지방소득세": {
      "localizations": {
