    "세금을 떼지 않고 일당을 그대로 받는 경우예요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No tax is taken; you get the full daily wage."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세금을 떼지 않고 일당을 그대로 받는 경우예요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Налог не удерживается, вы получаете всю сумму."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Soliq ushlanmaydi, kunlik haq toʻliq beriladi."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không trừ thuế, nhận đủ lương ngày."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不扣税，日薪全额到手。"
          }
        }
      }
    },
