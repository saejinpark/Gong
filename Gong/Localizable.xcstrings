    "지원하지 않는 백업 버전(%lld)이에요. 앱을 최신 버전으로 업데이트해 주세요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This backup version (%lld) isn't supported. Please update the app."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지원하지 않는 백업 버전(%lld)이에요. 앱을 최신 버전으로 업데이트해 주세요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Версия копии (%lld) не поддерживается. Обновите приложение."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaxira versiyasi (%lld) qoʻllab-quvvatlanmaydi. Ilovani yangilang."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Phiên bản sao lưu (%lld) không được hỗ trợ. Hãy cập nhật ứng dụng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不支持的备份版本（%lld）。请更新应用。"
          }
        }
      }
    },
