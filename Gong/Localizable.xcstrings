    "휴대폰 설정 > 공수장 > 언어에서 이 앱만 다른 언어로 바꿀 수 있어요.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can choose a different language just for this app in Settings > Gongsu > Language."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴대폰 설정 > 공수장 > 언어에서 이 앱만 다른 언어로 바꿀 수 있어요."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Язык только для этого приложения можно выбрать в «Настройки» > «Гонсу» > «Язык»."
          }
        },
        "uz": {
          "stringUnit": {
            "state": "translated",
            "value": "Faqat shu ilova uchun tilni Sozlamalar > Gongsu > Til boʻlimida oʻzgartirish mumkin."
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể đổi ngôn ngữ riêng cho ứng dụng này trong Cài đặt > Sổ công > Ngôn ngữ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以在手机“设置 > 工数账 > 语言”中只为这个应用更改语言。"
          }
        }
      }
    },
